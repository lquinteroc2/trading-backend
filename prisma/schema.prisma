generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRADER
  VIEWER
}

enum MarketType {
  FOREX
  CRYPTO
  INDEX
  COMMODITY
  STOCK
}

enum Timeframe {
  M1
  M5
  M15
  M30
  H1
  H4
  D1
}

enum SignalDirection {
  BUY
  SELL
  NEUTRAL
}

enum SignalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  EXPIRED
}

enum SourceAgent {
  TECHNICAL
  FUNDAMENTAL
  RISK
  SUPERVISOR
  MANUAL
}

enum AgentType {
  TECHNICAL
  FUNDAMENTAL
  RISK
  EXECUTION
  SUPERVISOR
}

enum AgentDecisionAction {
  APPROVE
  REJECT
  WAIT
  MODIFY
}

enum TradeDirection {
  BUY
  SELL
}

enum PaperTradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum PaperTradeResult {
  WIN
  LOSS
  BREAKEVEN
  OPEN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(TRADER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Instrument {
  id            String          @id @default(uuid())
  symbol        String          @unique
  name          String
  marketType    MarketType
  brokerSymbol  String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  candles       MarketCandle[]
  signals       TradingSignal[]
  decisions     AgentDecision[]
  paperTrades   PaperTrade[]

  @@index([marketType, isActive])
}

model MarketCandle {
  id           String     @id @default(uuid())
  instrumentId String
  timeframe    Timeframe
  open         Decimal    @db.Decimal(20, 8)
  high         Decimal    @db.Decimal(20, 8)
  low          Decimal    @db.Decimal(20, 8)
  close        Decimal    @db.Decimal(20, 8)
  volume       Decimal    @db.Decimal(24, 8)
  timestamp    DateTime
  source       String
  createdAt    DateTime   @default(now())
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe, timestamp])
}

model TradingSignal {
  id              String           @id @default(uuid())
  instrumentId    String
  direction       SignalDirection
  entryPrice      Decimal          @db.Decimal(20, 8)
  stopLoss        Decimal?         @db.Decimal(20, 8)
  takeProfit      Decimal?         @db.Decimal(20, 8)
  confidenceScore Int
  status          SignalStatus     @default(PENDING)
  sourceAgent     SourceAgent
  reasoning       String?
  createdAt       DateTime         @default(now())
  expiresAt       DateTime?
  instrument      Instrument       @relation(fields: [instrumentId], references: [id])
  decisions       AgentDecision[]
  paperTrades     PaperTrade[]

  @@index([instrumentId, status, createdAt])
}

model AgentDecision {
  id              String              @id @default(uuid())
  agentType       AgentType
  instrumentId    String
  signalId        String?
  decision        AgentDecisionAction
  confidenceScore Int
  reasoning       String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  instrument      Instrument          @relation(fields: [instrumentId], references: [id])
  signal          TradingSignal?      @relation(fields: [signalId], references: [id])

  @@index([agentType, createdAt])
  @@index([instrumentId, signalId])
}

model PaperTrade {
  id           String           @id @default(uuid())
  signalId     String?
  instrumentId String
  direction    TradeDirection
  entryPrice   Decimal          @db.Decimal(20, 8)
  stopLoss     Decimal?         @db.Decimal(20, 8)
  takeProfit   Decimal?         @db.Decimal(20, 8)
  positionSize Decimal          @db.Decimal(24, 8)
  status       PaperTradeStatus @default(OPEN)
  openedAt     DateTime         @default(now())
  closedAt     DateTime?
  closePrice   Decimal?         @db.Decimal(20, 8)
  pnl          Decimal?         @db.Decimal(24, 8)
  pnlPercent   Decimal?         @db.Decimal(12, 6)
  result       PaperTradeResult @default(OPEN)
  signal       TradingSignal?   @relation(fields: [signalId], references: [id])
  instrument   Instrument       @relation(fields: [instrumentId], references: [id])

  @@index([instrumentId, status, openedAt])
}
