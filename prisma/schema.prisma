generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRADER
  VIEWER
}

enum MarketType {
  FOREX
  CRYPTO
  INDEX
  COMMODITY
  STOCK
}

enum Timeframe {
  M1
  M5
  M15
  M30
  H1
  H4
  D1
}

enum SignalDirection {
  BUY
  SELL
  NONE
  NEUTRAL
}

enum SignalStatus {
  CREATED
  UNDER_REVIEW
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  PENDING_MANUAL_APPROVAL
  MANUALLY_APPROVED
  MANUALLY_REJECTED
  EXECUTED_PAPER
  DRY_RUN_EXECUTED
  LIVE_EXECUTED
}

enum StrategyStatus {
  ACTIVE
  INACTIVE
}

enum SourceAgent {
  TECHNICAL
  FUNDAMENTAL
  RISK
  SUPERVISOR
  MANUAL
}

enum AgentType {
  TECHNICAL
  FUNDAMENTAL
  RISK
  EXECUTION
  SUPERVISOR
  MANUAL
}

enum AgentDecisionAction {
  APPROVE
  REJECT
  WAIT
  MODIFY
}

enum AgentExecutionSource {
  QUEUE
  MANUAL
}

enum TradeDirection {
  BUY
  SELL
}

enum PaperTradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum PaperTradingAccountStatus {
  ACTIVE
  INACTIVE
}

enum PaperTradeResult {
  WIN
  LOSS
  BREAKEVEN
  OPEN
}

enum PaperTradeCloseReason {
  STOP_LOSS
  TAKE_PROFIT
  MANUAL
  SYSTEM
}

enum BacktestStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BacktestTradeResult {
  WIN
  LOSS
  BREAKEVEN
}

enum RiskAssessmentDecision {
  APPROVED
  REJECTED
  ADJUSTED
}

enum SupervisorDecisionAction {
  OPERATE
  WAIT
  BLOCK
}

enum SystemMode {
  RESEARCH
  BACKTESTING
  PAPER_TRADING
  ASSISTED_TRADING
  LIVE_LIMITED
  SAFE_MODE
  PAUSED
}

enum ManualTradingDecisionAction {
  APPROVE
  REJECT
}

enum ManualExecutionTarget {
  PAPER_TRADING
  MT5_DRY_RUN
  NONE
}

enum DataSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SystemLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum BrokerConnectionStatus {
  SUCCESS
  FAILED
}

enum BrokerAction {
  ACCOUNT_INFO
  SYMBOLS
  PRICE
  DRY_RUN_ORDER
  PLACE_ORDER
}

enum BrokerOrderSimulationStatus {
  VALIDATED
  BLOCKED
  FAILED
}

enum LiveTradeStatus {
  REQUESTED
  EXECUTED
  REJECTED
  FAILED
  CLOSED
}

enum LiveExecutionAction {
  VALIDATION
  PLACE_ORDER
  BROKER_RESPONSE
  BLOCKED
  FAILED
}

enum LiveExecutionStatus {
  SUCCESS
  FAILED
  BLOCKED
}

enum AnalyticsExecutionType {
  BACKTEST
  PAPER_TRADING
  LIVE_LIMITED
}

enum AnalyticsPeriodType {
  DAILY
  WEEKLY
  MONTHLY
}

enum EconomicImpact {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(TRADER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshTokens AuthRefreshToken[]
  manualTradingDecisions ManualTradingDecision[]
  liveExecutionLogs LiveExecutionLog[]
}

model AuthRefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Instrument {
  id           String              @id @default(uuid())
  symbol       String              @unique
  name         String
  marketType   MarketType
  brokerSymbol String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  candles      MarketCandle[]
  syncJobs     MarketDataSyncJob[]
  signals      TradingSignal[]
  decisions    AgentDecision[]
  paperTrades  PaperTrade[]
  backtestRuns BacktestRun[]

  @@index([marketType, isActive])
}

model MarketCandle {
  id           String     @id @default(uuid())
  instrumentId String
  timeframe    Timeframe
  open         Decimal    @db.Decimal(20, 8)
  high         Decimal    @db.Decimal(20, 8)
  low          Decimal    @db.Decimal(20, 8)
  close        Decimal    @db.Decimal(20, 8)
  volume       Decimal    @db.Decimal(24, 8)
  timestamp    DateTime
  source       String
  createdAt    DateTime   @default(now())
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe, timestamp])
}

model MarketDataSyncJob {
  id                String         @id @default(uuid())
  provider          String
  instrumentId      String
  symbol            String
  timeframe         Timeframe
  startTime         DateTime
  endTime           DateTime?
  status            DataSyncStatus @default(PENDING)
  requestedLimit    Int?
  fetchedCount      Int            @default(0)
  insertedCount     Int            @default(0)
  skippedDuplicates Int            @default(0)
  errorMessage      String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime       @default(now())
  instrument        Instrument     @relation(fields: [instrumentId], references: [id])

  @@index([provider, status, createdAt])
  @@index([instrumentId, timeframe, startTime])
}

model TradingSignal {
  id              String           @id @default(uuid())
  instrumentId    String
  strategyId      String?
  timeframe       Timeframe?
  direction       SignalDirection
  entryPrice      Decimal          @db.Decimal(20, 8)
  stopLoss        Decimal?         @db.Decimal(20, 8)
  takeProfit      Decimal?         @db.Decimal(20, 8)
  confidenceScore Int
  status          SignalStatus     @default(CREATED)
  sourceAgent     SourceAgent
  candleTimestamp DateTime?
  reason          String?
  reasoning       String?
  createdAt       DateTime         @default(now())
  expiresAt       DateTime?
  instrument      Instrument       @relation(fields: [instrumentId], references: [id])
  strategy        Strategy?        @relation(fields: [strategyId], references: [id])
  decisions       AgentDecision[]
  paperTrades     PaperTrade[]
  riskAssessments RiskAssessment[]
  supervisorDecision SupervisorDecision?
  brokerOrderSimulations BrokerOrderSimulation[]
  manualTradingDecisions ManualTradingDecision[]
  liveTrades LiveTrade[]
  liveExecutionLogs LiveExecutionLog[]

  @@unique([instrumentId, timeframe, candleTimestamp])
  @@index([instrumentId, status, createdAt])
  @@index([strategyId, createdAt])
}

model Strategy {
  id           String            @id @default(uuid())
  name         String            @unique
  description  String
  status       StrategyStatus    @default(ACTIVE)
  createdAt    DateTime          @default(now())
  versions     StrategyVersion[]
  signals      TradingSignal[]
  backtestRuns BacktestRun[]
}

model StrategyVersion {
  id           String        @id @default(uuid())
  strategyId   String
  version      String
  parameters   Json
  isActive     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  strategy     Strategy      @relation(fields: [strategyId], references: [id])
  backtestRuns BacktestRun[]

  @@unique([strategyId, version])
  @@index([strategyId, isActive])
}

model AgentDecision {
  id              String               @id @default(uuid())
  agentType       AgentType
  instrumentId    String
  signalId        String?
  decision        AgentDecisionAction
  executionSource AgentExecutionSource @default(MANUAL)
  confidenceScore Int
  reasoning       String?
  metadata        Json?
  createdAt       DateTime             @default(now())
  instrument      Instrument           @relation(fields: [instrumentId], references: [id])
  signal          TradingSignal?       @relation(fields: [signalId], references: [id])

  @@index([agentType, createdAt])
  @@index([instrumentId, signalId])
}

model RiskProfile {
  id                 String           @id @default(uuid())
  name               String           @unique
  maxRiskPerTrade    Decimal          @db.Decimal(12, 8)
  maxDailyDrawdown   Decimal          @db.Decimal(12, 8)
  maxOpenTrades      Int
  minRiskRewardRatio Decimal          @db.Decimal(12, 8)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  assessments        RiskAssessment[]

  @@index([isActive, createdAt])
}

model SystemLog {
  id        String         @id @default(uuid())
  level     SystemLogLevel
  source    String
  message   String
  context   String?
  createdAt DateTime       @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
}

model EconomicEvent {
  id        String         @id @default(uuid())
  currency  String
  title     String
  impact    EconomicImpact
  eventTime DateTime
  source    String
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([currency, impact, eventTime])
  @@index([eventTime])
}

model RiskAssessment {
  id              String                 @id @default(uuid())
  signalId        String
  riskProfileId   String
  positionSize    Decimal                @db.Decimal(24, 8)
  monetaryRisk    Decimal                @db.Decimal(24, 8)
  riskRewardRatio Decimal                @db.Decimal(12, 8)
  decision        RiskAssessmentDecision
  reason          String
  createdAt       DateTime               @default(now())
  signal          TradingSignal          @relation(fields: [signalId], references: [id])
  riskProfile     RiskProfile            @relation(fields: [riskProfileId], references: [id])

  @@index([signalId, createdAt])
  @@index([riskProfileId, createdAt])
  @@index([decision, createdAt])
}

model SupervisorDecision {
  id              String                   @id @default(uuid())
  signalId        String                   @unique
  decision        SupervisorDecisionAction
  reason          String
  confidenceScore Int
  metadata        Json?
  createdAt       DateTime                 @default(now())
  signal          TradingSignal            @relation(fields: [signalId], references: [id])
  brokerOrderSimulations BrokerOrderSimulation[]
  manualTradingDecisions ManualTradingDecision[]

  @@index([decision, createdAt])
}

model ManualTradingDecision {
  id                   String                      @id @default(uuid())
  signalId             String
  supervisorDecisionId String
  userId               String
  decision             ManualTradingDecisionAction
  executionTarget      ManualExecutionTarget       @default(NONE)
  reason               String
  metadata             Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime                    @default(now())
  signal               TradingSignal               @relation(fields: [signalId], references: [id])
  supervisorDecision   SupervisorDecision           @relation(fields: [supervisorDecisionId], references: [id])
  user                 User                         @relation(fields: [userId], references: [id])
  liveTrades           LiveTrade[]

  @@index([signalId, createdAt])
  @@index([userId, createdAt])
  @@index([decision, executionTarget, createdAt])
}

model LiveTrade {
  id               String          @id @default(uuid())
  signalId         String
  manualDecisionId String
  brokerProvider   String
  brokerOrderId    String?
  symbol           String
  direction        TradeDirection
  volume           Decimal         @db.Decimal(24, 8)
  entryPrice       Decimal         @db.Decimal(20, 8)
  stopLoss         Decimal?        @db.Decimal(20, 8)
  takeProfit       Decimal?        @db.Decimal(20, 8)
  status           LiveTradeStatus
  requestPayload   Json
  responsePayload  Json?
  errorMessage     String?
  openedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  signal           TradingSignal   @relation(fields: [signalId], references: [id])
  manualDecision   ManualTradingDecision @relation(fields: [manualDecisionId], references: [id])

  @@index([signalId, createdAt])
  @@index([symbol, status, createdAt])
  @@index([manualDecisionId])
}

model LiveExecutionLog {
  id        String              @id @default(uuid())
  signalId  String?
  userId    String?
  action    LiveExecutionAction
  status    LiveExecutionStatus
  reason    String
  payload   Json?
  createdAt DateTime            @default(now())
  signal    TradingSignal?      @relation(fields: [signalId], references: [id])
  user      User?               @relation(fields: [userId], references: [id])

  @@index([signalId, createdAt])
  @@index([userId, createdAt])
  @@index([action, status, createdAt])
}

model LiveTradingLimits {
  id                 String   @id
  maxDailyLiveTrades Int      @default(1)
  maxDailyLoss       Decimal  @default(50) @db.Decimal(24, 8)
  maxVolumePerTrade  Decimal  @default(0.01) @db.Decimal(24, 8)
  allowedSymbols     Json
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AnalyticsReportSnapshot {
  id            String                 @id @default(uuid())
  executionType AnalyticsExecutionType
  periodType    AnalyticsPeriodType
  periodStart   DateTime
  periodEnd     DateTime
  metrics       Json
  createdAt     DateTime               @default(now())

  @@index([executionType, periodType, periodStart])
  @@index([createdAt])
}

model BrokerConnectionLog {
  id              String                 @id @default(uuid())
  provider        String
  status          BrokerConnectionStatus
  action          BrokerAction
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  createdAt       DateTime               @default(now())

  @@index([provider, action, createdAt])
  @@index([status, createdAt])
}

model BrokerOrderSimulation {
  id                   String                      @id @default(uuid())
  signalId             String?
  supervisorDecisionId String?
  provider             String
  symbol               String
  direction            TradeDirection
  volume               Decimal                     @db.Decimal(24, 8)
  entryPrice           Decimal                     @db.Decimal(20, 8)
  stopLoss             Decimal?                    @db.Decimal(20, 8)
  takeProfit           Decimal?                    @db.Decimal(20, 8)
  status               BrokerOrderSimulationStatus
  dryRun               Boolean                     @default(true)
  reason               String
  requestPayload       Json
  responsePayload      Json
  createdAt            DateTime                    @default(now())
  signal               TradingSignal?              @relation(fields: [signalId], references: [id])
  supervisorDecision   SupervisorDecision?          @relation(fields: [supervisorDecisionId], references: [id])

  @@index([signalId, createdAt])
  @@index([provider, symbol, createdAt])
  @@index([status, createdAt])
}

model SystemConfig {
  id         String     @id
  mode       SystemMode @default(PAPER_TRADING)
  killSwitch Boolean    @default(false)
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())
}

model PaperTradingAccount {
  id             String                    @id @default(uuid())
  name           String                    @unique
  initialBalance Decimal                   @db.Decimal(24, 8)
  balance        Decimal                   @db.Decimal(24, 8)
  equity         Decimal                   @db.Decimal(24, 8)
  currency       String                    @default("USD")
  status         PaperTradingAccountStatus @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  trades         PaperTrade[]

  @@index([status, createdAt])
}

model PaperTrade {
  id           String                 @id @default(uuid())
  accountId    String
  signalId     String?
  instrumentId String
  direction    TradeDirection
  entryPrice   Decimal                @db.Decimal(20, 8)
  stopLoss     Decimal?               @db.Decimal(20, 8)
  takeProfit   Decimal?               @db.Decimal(20, 8)
  positionSize Decimal                @db.Decimal(24, 8)
  status       PaperTradeStatus       @default(OPEN)
  openedAt     DateTime               @default(now())
  closedAt     DateTime?
  closePrice   Decimal?               @db.Decimal(20, 8)
  pnl          Decimal?               @db.Decimal(24, 8)
  pnlPercent   Decimal?               @db.Decimal(12, 6)
  result       PaperTradeResult       @default(OPEN)
  closeReason  PaperTradeCloseReason?
  account      PaperTradingAccount    @relation(fields: [accountId], references: [id])
  signal       TradingSignal?         @relation(fields: [signalId], references: [id])
  instrument   Instrument             @relation(fields: [instrumentId], references: [id])

  @@unique([signalId])
  @@index([accountId, status, openedAt])
  @@index([instrumentId, status, openedAt])
}

model BacktestRun {
  id                String           @id @default(uuid())
  strategyId        String
  strategyVersionId String?
  instrumentId      String
  timeframe         Timeframe
  startDate         DateTime
  endDate           DateTime
  initialBalance    Decimal          @db.Decimal(24, 8)
  finalBalance      Decimal?         @db.Decimal(24, 8)
  totalTrades       Int              @default(0)
  winningTrades     Int              @default(0)
  losingTrades      Int              @default(0)
  winRate           Decimal?         @db.Decimal(12, 8)
  grossProfit       Decimal          @default(0) @db.Decimal(24, 8)
  grossLoss         Decimal          @default(0) @db.Decimal(24, 8)
  profitFactor      Decimal?         @db.Decimal(20, 8)
  maxDrawdown       Decimal?         @db.Decimal(12, 8)
  netPnL            Decimal          @default(0) @db.Decimal(24, 8)
  averageWin        Decimal?         @db.Decimal(24, 8)
  averageLoss       Decimal?         @db.Decimal(24, 8)
  signalsBeforeFilters Int           @default(0)
  signalsAfterFilters  Int           @default(0)
  filteredSignals      Int           @default(0)
  filterReasons        Json?
  status            BacktestStatus   @default(RUNNING)
  errorMessage      String?
  createdAt         DateTime         @default(now())
  finishedAt        DateTime?
  strategy          Strategy         @relation(fields: [strategyId], references: [id])
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id])
  instrument        Instrument       @relation(fields: [instrumentId], references: [id])
  trades            BacktestTrade[]

  @@index([instrumentId, timeframe, createdAt])
  @@index([strategyId, createdAt])
  @@index([status, createdAt])
}

model BacktestTrade {
  id            String               @id @default(uuid())
  backtestRunId String
  signalId      String?
  direction     TradeDirection
  entryPrice    Decimal              @db.Decimal(20, 8)
  stopLoss      Decimal              @db.Decimal(20, 8)
  takeProfit    Decimal              @db.Decimal(20, 8)
  positionSize  Decimal              @db.Decimal(24, 8)
  openedAt      DateTime
  closedAt      DateTime?
  exitPrice     Decimal?             @db.Decimal(20, 8)
  pnl           Decimal?             @db.Decimal(24, 8)
  pnlPercent    Decimal?             @db.Decimal(12, 8)
  result        BacktestTradeResult?
  backtestRun   BacktestRun          @relation(fields: [backtestRunId], references: [id])

  @@index([backtestRunId, openedAt])
  @@index([signalId])
}
