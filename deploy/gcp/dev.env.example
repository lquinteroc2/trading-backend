# Copy to deploy/gcp/dev.env and adjust before running scripts.
PROJECT_ID=your-gcp-project-id
REGION=us-central1

ARTIFACT_REPOSITORY=trading-dev
VPC_CONNECTOR=trading-dev-connector

BACKEND_SERVICE=trading-backend-dev
TECHNICAL_AGENT_SERVICE=trading-technical-agent-dev
MT5_DRY_RUN_SERVICE=trading-mt5-dry-run-dev

BACKEND_RUNTIME_SA=trading-backend-dev-sa
WORKER_RUNTIME_SA=trading-worker-dev-sa

CLOUD_SQL_INSTANCE=trading-postgres-dev
CLOUD_SQL_DATABASE=trading
CLOUD_SQL_USER=trading
CLOUD_SQL_TIER=db-f1-micro

REDIS_INSTANCE=trading-redis-dev
REDIS_SIZE_GB=1

CORS_ORIGINS=https://your-frontend-dev.example.com

# For MT5 option B: Windows VPS external worker.
# Keep live trading disabled until the VPS worker is installed, restricted, and tested.
MT5_WORKER_BASE_URL=
MT5_WORKER_API_KEY=
ENABLE_LIVE_TRADING=false
MT5_DRY_RUN=true
